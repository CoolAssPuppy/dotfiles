# Theme and appearance
theme = Catppuccin Mocha
font-size = 14
background-blur-radius = 10
background-opacity = 0.8
window-decoration = true
macos-titlebar-style = tabs
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

# Behavior
mouse-hide-while-typing = true
macos-option-as-alt = true
focus-follows-mouse = true
copy-on-select = true

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Quick terminal (uncomment to enable)
# keybind = global:cmd+/=toggle_quick_terminal

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:top
keybind = cmd+opt+down=goto_split:bottom
keybind = cmd+shift+z=toggle_split_zoom
keybind = cmd+shift+equal=equalize_splits
unfocused-split-opacity = 0.7

# Prompt navigation (jump between shell prompts)
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1
