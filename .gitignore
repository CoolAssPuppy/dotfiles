# Environment and secrets
.env
.env.*
*.env

# Private keys and certificates
*.pem
*.p8
*.p12
*.pfx
*.key
*.cer

# Credentials
*credentials*
*secrets*

# OS generated
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~

# Generated agent skill links
# Skills are authored in ~/Developer/brain/skills and published here by
# brain/scripts/link-skills.sh, one absolute symlink per skill. Absolute paths
# do not survive a clone, and the installer recreates the whole directory on any
# machine, so none of it is committed. i-have-adhd is a submodule and is
# tracked through .gitmodules, not this rule.
# Read README-agent-skills.md for the layout.
claude/skills/*
!claude/skills/i-have-adhd
claude/skills/.*/
claude/skills/skills/
